# Variables de entorno de ejemplo. Copiar a .env y ajustar.
# Los valores son placeholders; nunca se commitan valores reales.

# Puerto del backend
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/pasajes

# Secreto para firmar el JWT (obligatorio en despliegue real)
JWT_SECRET=cambiar-en-despliegue

# Vigencia del access token (ADR 0004)
JWT_EXPIRES_IN=30m

# Fotografías de Fleet: ruta absoluta privada, separada del almacenamiento de pagos.
# Compose monta fleet_photos en esta ruta; fuera de Docker usar una ruta absoluta propia.
BUS_PHOTO_STORAGE_DIR=/home/node/fleet-photos
